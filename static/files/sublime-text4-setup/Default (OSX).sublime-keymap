[
	// Go: ⌘B = go run
	{
		"keys": ["super+b"],
		"command": "build",
		"args": { "build_system": "Packages/User/Go.sublime-build" },
		"context":
		[
			{ "key": "selector", "operator": "equal", "operand": "source.go" }
		]
	},
	{
		"keys": ["super+shift+b"],
		"command": "build",
		"args": { "build_system": "Packages/User/Go.sublime-build", "select": true },
		"context":
		[
			{ "key": "selector", "operator": "equal", "operand": "source.go" }
		]
	},

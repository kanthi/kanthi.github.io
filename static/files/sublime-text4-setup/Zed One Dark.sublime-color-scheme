{
	"name": "Zed One Dark",
	"author": "Ported from Zed Industries One Dark",
	"variables":
	{
		"bg": "#282c33",
		"bg-panel": "#2f343e",
		"bg-chrome": "#3b414d",
		"fg": "#acb2be",
		"fg-bright": "#dce0e5",
		"fg-muted": "#a9afbc",
		"comment": "#5d636f",
		"accent": "#74ade8",
		"redish": "#e06c75",
		"orangish": "#bf956a",
		"yellowish": "#e5c07b",
		"greenish": "#98c379",
		"cyanish": "#56b6c2",
		"bluish": "#61afef",
		"purplish": "#c678dd",
		"pinkish": "#d07277"
	},
	"globals":
	{
		"background": "var(bg)",
		"foreground": "var(fg)",
		"invisibles": "#4e5a5f",
		"caret": "var(accent)",
		"block_caret": "#74ade866",
		"line_highlight": "#2f343ebf",
		"selection": "#74ade83d",
		"selection_border": "#74ade800",
		"inactive_selection": "#454a5666",
		"selection_corner_style": "round",
		"selection_corner_radius": "2",
		"highlight": "#74ade866",
		"find_highlight": "#e8af7466",
		"find_highlight_foreground": "var(fg-bright)",
		"guide": "#c8ccd40d",
		"active_guide": "#c8ccd41a",
		"stack_guide": "#c8ccd408",
		"brackets_options": "underline",
		"brackets_foreground": "var(accent)",
		"bracket_contents_options": "underline",
		"bracket_contents_foreground": "var(cyanish)",
		"tags_options": "underline",
		"tags_foreground": "var(pinkish)",
		"shadow": "#00000040",
		"shadow_width": "4",
		"gutter": "var(bg)",
		"gutter_foreground": "#4e5a5f",
		"gutter_foreground_highlight": "#d0d4da",
		"line_diff_width": "2",
		"line_diff_added": "#27a657",
		"line_diff_modified": "#d3b020",
		"line_diff_deleted": "#e06c76",
		"fold_marker": "var(accent)",
		"accent": "#74ade8",
		"misspelling": "var(redish)",
		"popup_css": "html { background-color: #2f343e; color: #dce0e5; } body { color: #dce0e5; } a { color: #74ade8; } .error { color: #d07277; } .success { color: #a1c181; } .warning { color: #dec184; }",
		"phantom_css": "html { background-color: #2f343e; color: #dce0e5; } body { color: #dce0e5; }"
	},
	"rules":
	[
		{ "scope": "comment, punctuation.definition.comment", "foreground": "var(comment)" },
		{ "scope": "comment.block.documentation, string.quoted.docstring", "foreground": "#878e98" },
		{ "scope": "keyword, keyword.control, keyword.operator.word, storage.modifier, storage.type.function, storage.type.class, storage.type.struct, storage.type.enum, keyword.declaration", "foreground": "var(purplish)" },
		{ "scope": "storage.type, keyword.type, support.type, entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.union, entity.name.impl, entity.other.inherited-class", "foreground": "var(cyanish)" },
		{ "scope": "entity.name.function, support.function, meta.function-call variable.function, meta.method-call variable.function", "foreground": "var(bluish)" },
		{ "scope": "variable.parameter, meta.parameter", "foreground": "var(pinkish)" },
		{ "scope": "variable, variable.other, variable.language, support.variable", "foreground": "var(fg)" },
		{ "scope": "variable.language.this, variable.language.self, variable.language.super, constant.language", "foreground": "var(orangish)" },
		{ "scope": "constant, constant.numeric, constant.language.boolean, constant.character.escape", "foreground": "var(orangish)" },
		{ "scope": "constant.other, entity.name.constant, variable.other.constant, support.constant", "foreground": "var(yellowish)" },
		{ "scope": "string, string.quoted", "foreground": "var(greenish)" },
		{ "scope": "string.regexp", "foreground": "var(orangish)" },
		{ "scope": "constant.character.escape, string.escape", "foreground": "#878e98" },
		{ "scope": "punctuation, meta.brace", "foreground": "var(fg)" },
		{ "scope": "punctuation.section, punctuation.definition.parameters, punctuation.definition.bracket, meta.brace.square, meta.brace.round, meta.brace.curly", "foreground": "#b2b9c6" },
		{ "scope": "punctuation.separator, punctuation.terminator, punctuation.accessor", "foreground": "#b2b9c6" },
		{ "scope": "keyword.operator, keyword.operator.assignment, keyword.operator.comparison, keyword.operator.arithmetic, keyword.operator.logical", "foreground": "var(cyanish)" },
		{ "scope": "entity.name.tag, support.class.component", "foreground": "var(accent)" },
		{ "scope": "entity.other.attribute-name", "foreground": "var(accent)" },
		{ "scope": "support.type.property-name, meta.mapping.key, entity.name.tag.yaml, meta.object-literal.key", "foreground": "var(pinkish)" },
		{ "scope": "entity.name.namespace, entity.name.module, support.module, entity.name.package", "foreground": "var(fg-bright)" },
		{ "scope": "entity.name.label", "foreground": "var(accent)" },
		{ "scope": "markup.heading", "foreground": "var(pinkish)" },
		{ "scope": "markup.bold", "foreground": "var(orangish)", "font_style": "bold" },
		{ "scope": "markup.italic", "foreground": "var(accent)", "font_style": "italic" },
		{ "scope": "markup.underline.link, string.other.link", "foreground": "var(cyanish)" },
		{ "scope": "markup.raw, markup.inline.raw", "foreground": "var(greenish)" },
		{ "scope": "markup.list", "foreground": "var(pinkish)" },
		{ "scope": "markup.quote", "foreground": "#878e98", "font_style": "italic" },
		{ "scope": "markup.inserted, diff.inserted", "foreground": "var(greenish)" },
		{ "scope": "markup.deleted, diff.deleted", "foreground": "var(redish)" },
		{ "scope": "markup.changed, diff.changed", "foreground": "var(yellowish)" },
		{ "scope": "invalid, invalid.illegal", "foreground": "var(redish)" },
		{ "scope": "invalid.deprecated", "foreground": "var(yellowish)" },
		{ "scope": "meta.preprocessor, keyword.control.directive, punctuation.definition.directive", "foreground": "var(purplish)" },
		{ "scope": "support.function.builtin, support.function.magic", "foreground": "var(bluish)" },
		{ "scope": "entity.name.function.constructor, support.function.construct", "foreground": "var(bluish)" },
		{ "scope": "meta.annotation, punctuation.definition.annotation, storage.type.annotation", "foreground": "var(accent)" },

		// Odin language scopes (sublime-odin)
		{ "scope": "source.odin", "foreground": "var(fg)" },
		{ "scope": "comment.line.odin, comment.block.odin, comment.line.double-slash.odin", "foreground": "var(comment)" },
		{ "scope": "keyword.control.odin, keyword.function.odin, keyword.operator.odin, keyword.logic.odin, keyword.tag.odin, keyword.operator.pointer.odin", "foreground": "var(purplish)" },
		{ "scope": "storage.type.odin", "foreground": "var(cyanish)" },
		{ "scope": "constant.language.odin, constant.numeric.odin", "foreground": "var(orangish)" },
		{ "scope": "string.quoted.odin, string.quoted.double.odin, string.quoted.raw.odin, string.odin", "foreground": "var(greenish)" },
		{ "scope": "entity.name.function.odin, meta.function.odin", "foreground": "var(bluish)" },
		{ "scope": "entity.name.type.odin, entity.name.struct.odin", "foreground": "var(cyanish)" },
		{ "scope": "variable.parameter.odin, variable.other.odin", "foreground": "var(fg)" },
		{ "scope": "punctuation.definition.comment.odin, punctuation.separator.odin, punctuation.accessor.odin", "foreground": "#b2b9c6" },
]
}

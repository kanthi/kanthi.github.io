{
	"name": "Zed One Light",
	"author": "Ported from Zed Industries One Light",
	"variables":
	{
		"bg": "#fafafa",
		"bg-panel": "#ebebec",
		"bg-chrome": "#dcdcdd",
		"fg": "#242529",
		"fg-muted": "#58585a",
		"comment": "#a2a3a7",
		"accent": "#5c78e2",
		"redish": "#e45649",
		"orangish": "#ad6e25",
		"yellowish": "#c18401",
		"greenish": "#50a14f",
		"cyanish": "#0997b3",
		"bluish": "#2f5af3",
		"purplish": "#a449ab",
		"pinkish": "#d3604f"
	},
	"globals":
	{
		"background": "var(bg)",
		"foreground": "var(fg)",
		"invisibles": "#b4b4bb",
		"caret": "var(accent)",
		"block_caret": "#5c78e266",
		"line_highlight": "#ebebecbf",
		"selection": "#5c78e23d",
		"inactive_selection": "#cacaca66",
		"selection_corner_style": "round",
		"selection_corner_radius": "2",
		"highlight": "#5c79e266",
		"find_highlight": "#d0a92366",
		"find_highlight_foreground": "var(fg)",
		"guide": "#383a410d",
		"active_guide": "#383a411a",
		"brackets_options": "underline",
		"brackets_foreground": "var(accent)",
		"bracket_contents_options": "underline",
		"bracket_contents_foreground": "var(cyanish)",
		"tags_options": "underline",
		"tags_foreground": "var(pinkish)",
		"shadow": "#00000020",
		"shadow_width": "4",
		"gutter": "var(bg)",
		"gutter_foreground": "#b4b4bb",
		"gutter_foreground_highlight": "#44454b",
		"line_diff_width": "2",
		"line_diff_added": "#27a657",
		"line_diff_modified": "#d3b020",
		"line_diff_deleted": "#e06c76",
		"accent": "#5c78e2",
		"misspelling": "var(redish)",
		"popup_css": "html { background-color: #ebebec; color: #242529; } body { color: #242529; } a { color: #5c78e2; }"
	},
	"rules":
	[
		{ "scope": "comment, punctuation.definition.comment", "foreground": "var(comment)" },
		{ "scope": "comment.block.documentation, string.quoted.docstring", "foreground": "#7c7e86" },
		{ "scope": "keyword, keyword.control, keyword.operator.word, storage.modifier, storage.type.function, storage.type.class, storage.type.struct, storage.type.enum, keyword.declaration", "foreground": "var(purplish)" },
		{ "scope": "storage.type, keyword.type, support.type, entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.other.inherited-class", "foreground": "#3882b7" },
		{ "scope": "entity.name.function, support.function, meta.function-call variable.function", "foreground": "var(accent)" },
		{ "scope": "variable.parameter, meta.parameter", "foreground": "var(pinkish)" },
		{ "scope": "variable, variable.other, variable.language, support.variable", "foreground": "var(fg)" },
		{ "scope": "variable.language.this, variable.language.self, constant.language", "foreground": "var(orangish)" },
		{ "scope": "constant, constant.numeric, constant.language.boolean", "foreground": "var(orangish)" },
		{ "scope": "constant.other, entity.name.constant, variable.other.constant, support.constant", "foreground": "var(yellowish)" },
		{ "scope": "string, string.quoted", "foreground": "var(greenish)" },
		{ "scope": "string.regexp", "foreground": "var(orangish)" },
		{ "scope": "constant.character.escape, string.escape", "foreground": "#7c7e86" },
		{ "scope": "punctuation, meta.brace", "foreground": "var(fg)" },
		{ "scope": "punctuation.section, punctuation.definition.parameters, punctuation.definition.bracket, meta.brace", "foreground": "#4d4f52" },
		{ "scope": "keyword.operator", "foreground": "#3882b7" },
		{ "scope": "entity.name.tag, support.class.component", "foreground": "var(accent)" },
		{ "scope": "entity.other.attribute-name", "foreground": "var(accent)" },
		{ "scope": "support.type.property-name, meta.mapping.key, meta.object-literal.key", "foreground": "var(pinkish)" },
		{ "scope": "entity.name.namespace, entity.name.module, support.module", "foreground": "var(fg)" },
		{ "scope": "markup.heading", "foreground": "var(pinkish)" },
		{ "scope": "markup.bold", "foreground": "var(orangish)", "font_style": "bold" },
		{ "scope": "markup.italic", "foreground": "var(accent)", "font_style": "italic" },
		{ "scope": "markup.underline.link", "foreground": "#3882b7" },
		{ "scope": "markup.raw, markup.inline.raw", "foreground": "var(greenish)" },
		{ "scope": "markup.inserted, diff.inserted", "foreground": "var(greenish)" },
		{ "scope": "markup.deleted, diff.deleted", "foreground": "var(redish)" },
		{ "scope": "invalid, invalid.illegal", "foreground": "var(redish)" },
		{ "scope": "invalid.deprecated", "foreground": "var(yellowish)" },

		// Odin language scopes (sublime-odin)
		{ "scope": "source.odin", "foreground": "var(fg)" },
		{ "scope": "comment.line.odin, comment.block.odin, comment.line.double-slash.odin", "foreground": "var(comment)" },
		{ "scope": "keyword.control.odin, keyword.function.odin, keyword.operator.odin, keyword.logic.odin, keyword.tag.odin, keyword.operator.pointer.odin", "foreground": "var(purplish)" },
		{ "scope": "storage.type.odin", "foreground": "var(cyanish)" },
		{ "scope": "constant.language.odin, constant.numeric.odin", "foreground": "var(orangish)" },
		{ "scope": "string.quoted.odin, string.quoted.double.odin, string.quoted.raw.odin, string.odin", "foreground": "var(greenish)" },
		{ "scope": "entity.name.function.odin, meta.function.odin", "foreground": "var(bluish)" },
		{ "scope": "entity.name.type.odin, entity.name.struct.odin", "foreground": "var(cyanish)" },
		{ "scope": "variable.parameter.odin, variable.other.odin", "foreground": "var(fg)" },
]
}

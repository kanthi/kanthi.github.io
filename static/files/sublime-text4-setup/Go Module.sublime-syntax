%YAML 1.2
---
name: Go Module
# Extension is "mod" / "work" (from go.mod / go.work)
file_extensions:
  - mod
  - work
first_line_match: '^(module|go|toolchain)\s+\S'
scope: source.go.mod
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.go.mod
    - match: \b(module|go|require|replace|exclude|retract|toolchain|retract)\b
      scope: keyword.control.go.mod
    - match: 'v[0-9][\w\.\-+]*'
      scope: constant.other.version.go.mod
    - match: '[A-Za-z0-9_./\-]+'
      scope: meta.path.go.mod
